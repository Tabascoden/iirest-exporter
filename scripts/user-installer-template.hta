<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta http-equiv="x-ua-compatible" content="IE=11">
  <title>iiRest Exporter Install Helper</title>
  <hta:application
    id="iiRestExporterInstallHelper"
    applicationname="iiRest Exporter Install Helper"
    border="thin"
    caption="yes"
    maximizebutton="no"
    minimizebutton="yes"
    scroll="no"
    singleinstance="yes"
    sysmenu="yes"
    windowstate="normal"
  />
  <style>
    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      background: #f6f2ea;
      color: #19242c;
      font-family: "Segoe UI", Tahoma, sans-serif;
      font-size: 14px;
    }

    .shell {
      padding: 28px;
    }

    .badge {
      display: inline-block;
      padding: 5px 9px;
      border: 1px solid #bdd0c6;
      background: #e7f0ea;
      color: #22563e;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    h1 {
      margin: 15px 0 8px;
      color: #121d25;
      font-size: 28px;
      font-weight: 700;
      line-height: 1.15;
    }

    .lead {
      margin: 0 0 18px;
      color: #4a5a64;
      font-size: 15px;
      line-height: 1.45;
    }

    .panel {
      margin: 16px 0;
      padding: 18px;
      border: 1px solid #d8d0c2;
      background: #fffbf3;
    }

    .step {
      margin: 0 0 12px;
      line-height: 1.42;
    }

    .step strong {
      color: #121d25;
    }

    .label {
      margin: 14px 0 7px;
      color: #51626d;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .4px;
      text-transform: uppercase;
    }

    .path {
      box-sizing: border-box;
      width: 100%;
      padding: 10px 11px;
      border: 1px solid #c5d1ca;
      background: #ffffff;
      color: #26323a;
      font-family: Consolas, "Courier New", monospace;
      font-size: 12px;
    }

    .actions {
      margin-top: 16px;
    }

    button {
      min-width: 178px;
      margin-right: 8px;
      padding: 11px 14px;
      border: 1px solid #2f6f55;
      background: #2f6f55;
      color: #ffffff;
      font-family: "Segoe UI", Tahoma, sans-serif;
      font-size: 14px;
      font-weight: 700;
      cursor: hand;
    }

    button.secondary {
      border-color: #b7c5bd;
      background: #ffffff;
      color: #2f4d41;
    }

    .status {
      min-height: 34px;
      margin-top: 15px;
      color: #2f6f55;
      font-weight: 700;
      line-height: 1.35;
    }

    .status.error {
      color: #b42318;
    }
  </style>
  <script language="javascript">
    var chromePage = "chrome://extensions";

    function getShell() {
      return new ActiveXObject("WScript.Shell");
    }

    function getFileSystem() {
      return new ActiveXObject("Scripting.FileSystemObject");
    }

    function getHelperFolder() {
      var path = document.location.pathname;
      if (path.charAt(0) === "/") {
        path = path.substring(1);
      }
      path = path.replace(/\//g, "\\");
      try {
        path = decodeURIComponent(path);
      } catch (error) {
        path = unescape(path);
      }
      return path.substring(0, path.lastIndexOf("\\") + 1);
    }

    function getExtensionPath() {
      return getHelperFolder() + "_iirest-exporter\\extension";
    }

    function setStatus(message, isError) {
      var status = document.getElementById("status");
      status.className = isError ? "status error" : "status";
      status.innerHTML = message;
    }

    function copyText(elementId, successText) {
      var input = document.getElementById(elementId);
      input.select();

      try {
        window.clipboardData.setData("Text", input.value);
        setStatus(successText, false);
        return true;
      } catch (error) {
        setStatus("Не удалось скопировать автоматически. Выделите поле и нажмите Ctrl+C.", true);
        return false;
      }
    }

    function readRegistry(path) {
      try {
        return getShell().RegRead(path);
      } catch (error) {
        return "";
      }
    }

    function normalizeExePath(path) {
      if (!path) {
        return "";
      }
      return String(path).replace(/^"|"$/g, "");
    }

    function findChromeExe() {
      var shell = getShell();
      var files = getFileSystem();
      var candidates = [
        readRegistry("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\App Paths\\chrome.exe\\"),
        readRegistry("HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\App Paths\\chrome.exe\\"),
        readRegistry("HKLM\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\App Paths\\chrome.exe\\"),
        shell.ExpandEnvironmentStrings("%ProgramFiles%") + "\\Google\\Chrome\\Application\\chrome.exe",
        shell.ExpandEnvironmentStrings("%ProgramFiles(x86)%") + "\\Google\\Chrome\\Application\\chrome.exe",
        shell.ExpandEnvironmentStrings("%LocalAppData%") + "\\Google\\Chrome\\Application\\chrome.exe"
      ];

      for (var i = 0; i < candidates.length; i++) {
        var candidate = normalizeExePath(candidates[i]);
        if (candidate && files.FileExists(candidate)) {
          return candidate;
        }
      }

      return "";
    }

    function openChromeExtensions() {
      var chromeExe = findChromeExe();
      if (!chromeExe) {
        setStatus("Chrome не найден автоматически. Откройте Chrome вручную и введите chrome://extensions в адресную строку.", true);
        return;
      }

      getShell().Run("\"" + chromeExe + "\" \"" + chromePage + "\"", 1, false);
      setStatus("Chrome открыт. Перейдите в управление расширениями, включите режим разработчика, нажмите Load unpacked и вставьте путь к папке расширения.", false);
    }

    function checkExtensionPath() {
      var files = getFileSystem();
      var manifestPath = getExtensionPath() + "\\manifest.json";
      if (!files.FileExists(manifestPath)) {
        setStatus("Файлы расширения не найдены. Не переносите этот файл отдельно от папки iiRest Exporter.", true);
      }
    }

    function init() {
      window.resizeTo(670, 540);
      document.getElementById("extensionPath").value = getExtensionPath();
      checkExtensionPath();
    }
  </script>
</head>
<body onload="init()">
  <div class="shell">
    <div class="badge">Chrome extension</div>
    <h1>Установка iiRest Exporter</h1>
    <p class="lead">Расширение уже собрано в этой папке. Это окно только показывает шаги и копирует правильные адреса.</p>

    <div class="panel">
      <p class="step"><strong>1.</strong> Нажмите <strong>Открыть Chrome</strong>.</p>
      <p class="step"><strong>2.</strong> Откройте <strong>Extensions / Управление расширениями</strong>.</p>
      <p class="step"><strong>3.</strong> Включите <strong>Developer mode / Режим разработчика</strong>.</p>
      <p class="step"><strong>4.</strong> Нажмите <strong>Load unpacked / Загрузить распакованное</strong>.</p>
      <p class="step"><strong>5.</strong> Вставьте путь к папке расширения из поля ниже и нажмите выбор папки.</p>

      <div class="label">Папка расширения для Load unpacked</div>
      <input id="extensionPath" class="path" type="text" readonly>
    </div>

    <div class="actions">
      <button onclick="openChromeExtensions()">Открыть Chrome</button>
      <button class="secondary" onclick="copyText('extensionPath', 'Путь к папке расширения скопирован.')">Скопировать путь</button>
    </div>

    <div id="status" class="status"></div>
  </div>
</body>
</html>
